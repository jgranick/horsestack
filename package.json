{
  "name": "low-poly-farm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:assets": "rolldown scripts/validate-assets.ts --platform=node --format=esm --file=/tmp/pasture-house-validate.mjs --logLevel=silent && node /tmp/pasture-house-validate.mjs"
  },
  "dependencies": {
    "@flighthq/sdk": "0.3.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "rolldown": "1.2.5",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
